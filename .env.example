# =========================================================
# SyncStage · 环境变量示例
# 复制为 .env 后使用：copy .env.example .env
# 重要：任何真实 API Key 都不允许写入前端代码或提交到 Git。
#       前端只允许使用 VITE_ 开头的公开配置。
# =========================================================

# ---------------- 前端（frontend/.env.local）----------------
# 后端接口地址（后端 Agent 启动后，前端会自动探测并优先使用它）
VITE_API_BASE_URL=http://127.0.0.1:8000
# 留空 / 不设置 = auto：能连上后端就用后端 Agent，连不上自动回退到前端本地镜像链路。
# true = 强制只用前端本地 Demo 数据；false = 强制走后端接口。
# VITE_USE_MOCK_API=true
# 是否显示演示控制台（评委模式 / 案例切换 / 加载与错误状态）
VITE_DEMO_MODE=true
# Agent 运行模式：mock = 初赛 Demo 默认（只用本地预设数据，不访问任何大模型 API，
# 页面上会明确标注「Demo 模拟 Agent」）；live = 真实模型（必须在后端检测到有效配置）。
# 未配置时按 mock 处理；live 模式下没有可用模型会直接提示，不会静默回退。
VITE_AGENT_MODE=mock

# ---------------- 后端（backend/.env）----------------
APP_ENV=development
HOST=127.0.0.1
# 注意：改了 PORT 之后，必须同步修改 frontend/.env.local 的 VITE_API_BASE_URL，
# 否则前端会连不上后端，Agent 对话会直接报「无法连接后端服务」。
PORT=8000
DATABASE_URL=sqlite:///./data/same_frequency.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# ---------------- TME 数据适配层（腾讯音乐融合）----------------
# mock     = 使用脱敏 Demo 数据（默认，初赛阶段用这个）
# official = 预留给未来的 TME 官方测试 API（当前不会伪造实现，调用会明确报错）
TME_PROVIDER=mock

# 以下变量只有在 TME_PROVIDER=official 并且拿到官方测试权限后才会用到。
# 接入步骤见 backend/app/integrations/official_tme.py 里的 TODO(1..8)。
# 注意：客户端密钥只允许放在后端环境变量里，绝对不能下发到前端。
TME_CLIENT_ID=
TME_CLIENT_SECRET=
TME_API_BASE_URL=
TME_SCOPE=user_music_profile,event_context,track_metadata

# ---------------- 真实大模型 ----------------
# Agent 运行模式（后端）：mock = 不访问任何外部大模型 API（初赛默认）；
# live = 允许真实模型调用，只有 ai_status.enabled 为 true 时才会真正启用。
AGENT_MODE=mock

# ---------------- 大模型网关（厂商无关，backend/.env）----------------
# 后端 app/services/llm 的 LLMGateway 只认下面这组变量；业务代码不直接依赖任何厂商 SDK。
# 密钥来源唯一：LLM_API_KEY（兼容读取 DEEPSEEK_API_KEY，内部统一映射为 LLM_API_KEY）。
# 绝对不要创建 VITE_LLM_API_KEY：任何 VITE_ 变量都会打包进前端产物。
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=20

# 前端只保留这一个开关：live = 走上面的后端网关；
# 未配置 LLM_API_KEY / LLM_MODEL 时后端会立刻返回 LLM_NOT_CONFIGURED，
# 页面显示「尚未配置大模型服务」，不会静默回退、不会无限等待。
# VITE_AGENT_MODE=live

# openai = 标准 /chat/completions；ollama = 本机 Ollama 原生 /api/chat（可关闭思考，响应更快）
# 不填 OPENAI_API_STYLE 时，按 base_url 端口自动判断（11434 -> ollama）。
OPENAI_API_STYLE=

# 1) OpenAI 或任何兼容网关
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# 2) 本机 Ollama（默认，本地推理服务不需要 API Key；这是开箱即用的配置）
#    ollama pull qwen3.5:0.8b   # 先确认模型真的在本机
#    自检：cd backend && python scripts/llm_check.py
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_MODEL=qwen3.5:0.8b
OPENAI_API_KEY=
OPENAI_TIMEOUT=60

# 置为 1 会强制使用「显式 Demo 回退」：返回带 source=demo-fallback 标记的本地模板，
# 前端会明确标注"未调用大模型"，不会伪装成真实模型输出。
AI_FORCE_FALLBACK=

# 说明：模型调用失败时（Key 无效 / 超时 / 连不上 / 模型不存在）后端会返回带
# code + message + hint 的错误体，前端显示失败原因与重试，绝不静默回退。
