# SyncStage public deployment template. Copy to a local .env only.
# Keep all values empty in this committed file. Never create VITE_* keys for API secrets.

# Frontend public configuration
VITE_API_BASE_URL=
VITE_DEMO_MODE=
VITE_AGENT_MODE=
VITE_ENABLE_LOCAL_AUDIO=
VITE_AUTH_MODE=
VITE_BASE_PATH=

# Backend runtime configuration (server only; never expose to the Vite build)
APP_ENV=
HOST=
PORT=
DATABASE_URL=
CORS_ORIGINS=
AGENT_MODE=
AGENT_INVITE_TTL_SECONDS=
TME_PROVIDER=
TME_CLIENT_ID=
TME_CLIENT_SECRET=
TME_API_BASE_URL=
TME_SCOPE=
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=
LLM_DISABLE_THINKING=
OPENAI_API_STYLE=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=
OPENAI_TIMEOUT=
AI_FORCE_FALLBACK=
