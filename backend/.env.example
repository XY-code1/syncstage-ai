# =========================================================
# 后端环境变量示例
# 复制为 backend/.env 后使用：copy .env.example .env
#
# 重要：密钥只能放在这个文件里（.env 已被 .gitignore 覆盖），
#       既不能提交到 Git，也不能写进任何 VITE_ 变量（会被打包进前端）。
#       仓库根目录的 .env.example 里还有前端（VITE_*）与 TME 数据源的示例。
# =========================================================

APP_ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./data/same_frequency.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------- Agent 运行模式 ----------------
# mock = 初赛 Demo 默认：不访问任何外部大模型 API，使用本地预设数据模拟；
# live = 真实模型：必须配置好下面的 LLM_API_KEY / LLM_MODEL，否则接口立即返回
#        LLM_NOT_CONFIGURED（503），页面显示「尚未配置大模型服务」，不静默回退。
AGENT_MODE=mock

# ---------------- 大模型网关（厂商无关）----------------
# app/services/llm 的 LLMGateway 只认这组变量；业务代码不直接依赖任何厂商 SDK。
# 密钥来源唯一：LLM_API_KEY（兼容读取 DEEPSEEK_API_KEY，内部统一映射为 LLM_API_KEY）。
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=20

# ---------------- 兼容：旧的 OpenAI / Ollama 通道 ----------------
# /api/agent/chat（聊天室对话）与 /api/ai/tags 仍走这一组变量，
# 本机 Ollama 免 Key，开箱即用。
OPENAI_API_STYLE=
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_MODEL=qwen3.5:0.8b
OPENAI_API_KEY=
OPENAI_TIMEOUT=60

# 置为 1 会强制使用「显式 Demo 回退」（带 source=demo-fallback 标记），
# 只在演示"模型不可用"时使用，不会伪装成真实模型输出。
AI_FORCE_FALLBACK=

# ---------------- TME 数据适配层 ----------------
# mock = 使用脱敏 Demo 数据（初赛默认）；official = 预留的官方测试 API（尚未实现，调用会明确报错）。
TME_PROVIDER=mock